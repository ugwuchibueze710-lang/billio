# ─────────────────────────────────────────────────────────────────────────
# Billio backend configuration. Copy this file to `.env` for local
# development (it's loaded automatically) and set the same variables as
# real environment variables in your Render service for production.
# NEVER commit a real .env file with real secrets.
# ─────────────────────────────────────────────────────────────────────────

# development | testing | production
FLASK_ENV=development

# --- Core secrets (REQUIRED) ---
# Generate strong random values, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# --- Database (REQUIRED) ---
# Local dev example: postgresql://billio:billio@localhost:5432/billio_dev
# Render: use the "Internal Database URL" from your Render Postgres instance.
DATABASE_URL=

# --- CORS (REQUIRED in production) ---
# Comma-separated list of exact origins allowed to call this API from a
# browser. Never use "*" in production. Example:
# CORS_ORIGINS=https://app.billio.example.com
CORS_ORIGINS=http://localhost:5173

# --- Frontend base URL (used to build links in emails / push deep-links) ---
FRONTEND_BASE_URL=http://localhost:5173

# --- Rate limiting storage ---
# Use a real Redis instance in production so limits are enforced across
# multiple server processes/instances. Falls back to in-memory (per-process,
# NOT safe for multi-instance production deployments) if unset.
REDIS_URL=

# --- Groq (AI bill extraction, assistant, audit explanations) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview
GROQ_TEXT_MODEL=llama-3.1-70b-versatile
GROQ_TIMEOUT_SECONDS=20

# --- Resend (transactional email: password reset, email reminders) ---
# Get a key at https://resend.com. RESEND_FROM_EMAIL's domain must be
# verified in Resend (SPF/DKIM) -- see README for setup steps.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Billio <noreply@yourdomain.com>

# --- Cloudflare R2 (object storage for uploaded bill photos) ---
# S3-compatible; create a bucket + API token at https://dash.cloudflare.com
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=billio-bill-documents
S3_REGION=auto

# --- Web Push (VAPID keys for browser push notifications) ---
# Generate with: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key, v.private_key)"
# or: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# --- Optional HTTP fallback trigger for the reminder scheduler ---
# Only needed if you're NOT using Render's native Cron Job (which should
# instead run `flask send-reminders` directly -- see README). If set, an
# authenticated POST to /api/notifications/run-scheduler with header
# `X-Scheduler-Token: <this value>` will trigger a reminder scan.
NOTIFICATION_SCHEDULER_TOKEN=

# --- Rate limits (sane defaults shown; adjust if needed) ---
LOGIN_RATE_LIMIT=5 per minute;30 per hour
SIGNUP_RATE_LIMIT=10 per hour
FEEDBACK_RATE_LIMIT=5 per hour;20 per day
AI_RATE_LIMIT=20 per hour
PASSWORD_RESET_RATE_LIMIT=5 per hour
